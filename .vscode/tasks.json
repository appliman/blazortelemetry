{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build BlazorTelemetry.Host",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/BlazorTelemetry.Host/BlazorTelemetry.Host.csproj",
                "--configuration",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
