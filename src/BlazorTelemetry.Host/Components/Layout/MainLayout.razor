@inherits LayoutComponentBase

<div class="host-account">
    <AuthorizeView>
        <Authorized>
            <a href="Account/Manage">@context.User.Identity?.Name</a>
            <AuthorizeView Policy="BlazorTelemetryAdministrator" Context="adminContext"><a href="administration">Administration</a></AuthorizeView>
            <form action="Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="" /><button type="submit">Sign out</button></form>
        </Authorized>
    </AuthorizeView>
</div>
@Body
