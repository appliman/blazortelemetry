@implements IAsyncDisposable
@using System.Security.Claims
@using BlazorTelemetry.Host.Administration
@inject DatabaseBackupWorker BackupWorker
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<DatabaseBackupNotification> Logger

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private IJSObjectReference? _module;
    private DatabaseBackupJob? _job;
    private bool _ready;
    private string? _downloadUrl;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _monitor = Monitor();
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_monitor is not null)
        {
            await _monitor;
        }
        _lifetime.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task Monitor()
    {
        try
        {
            var _state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var _owner = _state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!_state.User.IsInRole("Administrator") || string.IsNullOrWhiteSpace(_owner))
            {
                return;
            }
            using var _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            do
            {
                var _current = BackupWorker.Find(_owner);
                if (_current?.Id == _job?.Id)
                {
                    continue;
                }
                _job = _current;
                _ready = false;
                _downloadUrl = null;
                StateHasChanged();
                if (_current is null)
                {
                    continue;
                }
                _ready = await _current.Completion.WaitAsync(_lifetime.Token);
                if (_ready)
                {
                    _downloadUrl = $"administration/database/download/{_current.Id}";
                }
                StateHasChanged();
                if (_ready)
                {
                    try
                    {
                        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _lifetime.Token, "./database-backup.js");
                        await _module.InvokeVoidAsync("download", _lifetime.Token,
                            Navigation.ToAbsoluteUri(_downloadUrl!).ToString(), _current.Id.ToString());
                    }
                    catch (JSException)
                    {
                        // The notification still offers a direct download link.
                    }
                }
            }
            while (await _timer.WaitForNextTickAsync(_lifetime.Token));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception _exception)
        {
            Logger.LogError(_exception, "Database backup notification failed.");
        }
    }
}

@if (_job?.Completion.IsCompleted == true)
{
    <div class="backup-notification alert @(_ready ? "alert-success" : "alert-danger")" role="status" aria-live="polite">
        @if (_ready)
        {
            <strong>Your database ZIP is ready.</strong>
            <a class="alert-link d-block" href="@_downloadUrl" download data-enhance-nav="false">Download ZIP (available for 15 minutes)</a>
        }
        else
        {
            <strong>The database ZIP could not be prepared.</strong>
            <a class="alert-link d-block" href="administration#database-backup">Return to Administration to try again</a>
        }
    </div>
}
