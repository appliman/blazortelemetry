@page "/administration"
@attribute [Authorize(Policy = "BlazorTelemetryAdministrator")]
@rendermode InteractiveServer
@using System.Security.Cryptography
@using System.Text
@using BlazorTelemetry.Core
@inject ITelemetryRepository Repository

@code {
    private IReadOnlyList<IngestionApplication> _applications = [];
    private string _applicationName = string.Empty;
    private string? _generatedKey;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        _applications = await Repository.GetIngestionApplications(CancellationToken.None);
    }

    private async Task CreateIngestionKey()
    {
        if (string.IsNullOrWhiteSpace(_applicationName))
        {
            _message = "The application name is required.";
            return;
        }

        var secret = $"bt_{Convert.ToBase64String(RandomNumberGenerator.GetBytes(32)).TrimEnd('=').Replace('+', '-').Replace('/', '_')}";
        var application = new IngestionApplication
        {
            Name = _applicationName.Trim(),
            KeyPrefix = secret[..Math.Min(secret.Length, 11)],
            KeyHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(secret)))
        };
        await Repository.SaveIngestionApplication(application, CancellationToken.None);
        _generatedKey = secret;
        _applicationName = string.Empty;
        _message = "Key created. Copy it now; it will not be displayed again.";
        await Reload();
    }

    private async Task Revoke(IngestionApplication application)
    {
        application.IsActive = false;
        await Repository.SaveIngestionApplication(application, CancellationToken.None);
        _message = $"Key for {application.Name} revoked.";
        await Reload();
    }
}

<PageTitle>Administration · BlazorTelemetry</PageTitle>
<main class="admin-page">
    <header>
        <a href="/">← Dashboard</a>
        <h1>Administration</h1>
        <p>Manage ingestion access keys.</p>
    </header>

    @if (_message is not null)
    {
        <div class="admin-message" role="status">@_message</div>
    }

    <section>
        <h2>Ingestion keys</h2>
        <div class="admin-form key-form">
            <label>Application <input @bind="_applicationName" /></label>
            <button type="button" @onclick="CreateIngestionKey">Generate key</button>
        </div>
        @if (_generatedKey is not null)
        {
            <output class="generated-key">@_generatedKey</output>
        }
        <div class="admin-table" role="table" aria-label="Ingestion keys">
            @foreach (var application in _applications)
            {
                <div role="row">
                    <span role="cell"><strong>@application.Name</strong><small>@application.KeyPrefix… · @(application.IsActive ? "active" : "revoked")</small></span>
                    @if (application.IsActive)
                    {
                        <button type="button" class="danger" @onclick="() => Revoke(application)">Revoke</button>
                    }
                </div>
            }
        </div>
    </section>
</main>
