@page "/administration"
@attribute [Authorize(Policy = "BlazorTelemetryAdministrator")]
@rendermode InteractiveServer
@using BlazorTelemetry.Core
@using BlazorTelemetry.Host.Contracts.Models.IngestionApplications
@inject IMediator Repository
@inject BlazorTelemetryOptions Options

@code {
    private IReadOnlyList<IngestionApplication> _applications = [];
    private string? _error;
    private int? _selectedApplicationId;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        var result = await Repository.Send(new GetIngestionApplicationsRequest(), CancellationToken.None);
        _error = null;
        if (result.HasError)
        {
            _error = string.Join(" ", result.BrokenRules.Select(rule => rule.Message));
            return;
        }
        _applications = result.Data ?? [];
    }

    private void SelectApplication(int id)
    {
        _selectedApplicationId = id;
    }
}

<PageTitle>Administration · BlazorTelemetry</PageTitle>
<main class="admin-page">
    <header>
        <a href="/">← Dashboard</a>
        <h1>Administration</h1>
        <p>Manage ingestion, MCP read access, and telemetry options.</p>
        <nav class="admin-navigation" aria-label="Administration sections">
            <a class="btn btn-outline-light" href="#api-keys">API keys</a>
            <a class="btn btn-outline-light" href="#telemetry-options">Telemetry options</a>
        </nav>
    </header>

    @if (!Options.RequireIngestionKey)
    {
        <div class="admin-message" role="status">
            Ingestion key validation is disabled. Set BlazorTelemetry:RequireIngestionKey to true before relying on these keys.
        </div>
    }

    <section id="api-keys">
        <h2>API keys</h2>
        <ApiKeyCreate OnCreated="LoadApplications" />
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <div class="admin-table" role="table" aria-label="Ingestion keys">
            @foreach (var application in _applications)
            {
                <div role="row">
                    <span role="cell">
                        <strong>@application.Name</strong>
                        <small>@(application.IsMcpReadKey ? "MCP read access" : "OTLP ingestion")</small>
                        <small>@application.KeyPrefix… · @(!application.IsActive ? "Revoked" : application.ExpiresUtc <= DateTimeOffset.UtcNow ? "Expired" : "Active")</small>
                    </span>
                    <span role="cell">Expires: @(application.ExpiresUtc?.ToLocalTime().ToString("g") ?? "Never")</span>
                    <span role="cell">Last used: @(application.LastSeenUtc?.ToLocalTime().ToString("g") ?? "Never")</span>
                    <span role="cell">Uses: @application.UsageCount</span>
                    <button type="button" @onclick="() => SelectApplication(application.Id)">Manage</button>
                </div>
                @if (_selectedApplicationId == application.Id)
                {
                    <div class="selected-key">
                        <button type="button" class="btn btn-outline-light" @onclick="() => _selectedApplicationId = null">Close key details</button>
                        <ApiKeyDetail @key="application.Id" Id="application.Id" OnChanged="LoadApplications" />
                    </div>
                }
            }
        </div>
    </section>

    <div id="telemetry-options">
        <AdministrationOptions />
    </div>
</main>
