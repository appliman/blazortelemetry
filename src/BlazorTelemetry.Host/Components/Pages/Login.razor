@page "/login"
@inject NavigationManager Navigation

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public bool Error { get; set; }
}

<ApplicationPageTitle>Sign in</ApplicationPageTitle>
<main class="auth-page container py-5">
    <div class="auth-card mx-auto">
        <span class="auth-label">Secure access</span><h1>Sign in</h1>
        <p>Enter your identifier and the current code from your authenticator app.</p>
        @if (Error)
        {
            <div class="alert alert-danger" role="alert">The identifier or authentication code is invalid, or access is unavailable. New users must set up their authenticator first.</div>
        }
        <form method="post" action="@(new Uri(new Uri(Navigation.BaseUri), "b2fa/authenticate").AbsolutePath)" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div class="form-floating mb-3"><input required id="identifier" name="identifier" class="form-control" placeholder="Identifier" autocomplete="username" maxlength="256" /><label for="identifier">Identifier</label></div>
            <div class="form-floating mb-3"><input required id="code" name="code" class="form-control" placeholder="Authentication code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" /><label for="code">Authentication code</label></div>
            <button class="btn btn-primary" type="submit">Sign in</button>
        </form>
        <p class="auth-help"><a href="login/qr-code">Set up your authenticator</a></p>
    </div>
</main>
