@page "/"
@attribute [Authorize(Policy = "BlazorTelemetryReader")]
@rendermode InteractiveServer

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }
}

<PageTitle>BlazorTelemetry</PageTitle>
<div class="telemetry-page">
    <TelemetryDashboard @key="View" InitialView="@View">
        <SidebarFooter>
            <TelemetryAccount />
        </SidebarFooter>
    </TelemetryDashboard>
</div>
