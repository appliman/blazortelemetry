@page "/login/qr-code"
@rendermode InteractiveServer
@implements IDisposable
@using BlazorTelemetry.Host.Authentication
@using QRCoder
@using System.Web
@using System.Security.Cryptography
@using System.Text
@inject BlazorAuthConfiguration Settings
@inject UserAuthenticationService Authentication
@inject UserAttemptLimiter Limiter
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

@code {
    private readonly CancellationTokenSource _lifetime = new();

    public void Dispose()
    {
        _setupSecret = null;
        _secret = "";
        _image = null;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private string _identifier = "";
    private string _secret = "";
    private string? _image;
    private string? _error;
    private string? _setupIdentifier;
    private string? _setupSecret;
    private bool _adminSetup;
    private bool _busy;
    private bool _interactiveReady;
    private string _source = "unknown";

    protected override void OnInitialized()
    {
        _source = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "unknown";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }
    }

    private async Task Generate()
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            string? _uri;
            _adminSetup = Settings.AllowedUserLogins.Contains(_identifier.Trim(), StringComparer.OrdinalIgnoreCase);
            if (_adminSetup)
            {
                var _adminSecret = Settings.GetAdministratorSecret(_identifier);
                if (!Limiter.AllowSource(_source) || !Limiter.Allow(_identifier, _source) || string.IsNullOrWhiteSpace(_adminSecret)
                    || !CryptographicOperations.FixedTimeEquals(Encoding.UTF8.GetBytes(_secret), Encoding.UTF8.GetBytes(_adminSecret)))
                {
                    _error = "The identifier or secret is invalid, or setup is unavailable.";
                    return;
                }
                var _setup = new TwoFactorAuthenticator().GenerateSetupCode(Settings.Issuer, _identifier.Trim(), _adminSecret, 300, 300);
                _uri = HttpUtility.ParseQueryString(new Uri(_setup.QrCodeSetupImageUrl).Query).Get("chl");
            }
            else
            {
                _uri = await Authentication.SetupUri(_identifier, _secret, _lifetime.Token, _source);
            }
            if (_uri is null)
            {
                _error = "The identifier or secret is invalid, or setup is unavailable.";
                return;
            }
            using var _generator = new QRCodeGenerator();
            using var _data = _generator.CreateQrCode(_uri, QRCodeGenerator.ECCLevel.Q);
            using var _qr = new PngByteQRCode(_data);
            _image = Convert.ToBase64String(_qr.GetGraphic(8));
            _setupIdentifier = _identifier.Trim();
            _setupSecret = _secret;
            _secret = "";
        }
        finally
        {
            _busy = false;
        }
    }

}

<ApplicationPageTitle>Set up authentication</ApplicationPageTitle>
<main class="auth-page container py-5"><div class="auth-card mx-auto">
    <span class="auth-label">TOTP setup</span><h1>Set up your authenticator</h1>
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (_image is null)
    {
        <p>Enter your identifier and the secret provided by your administrator. Configured administrators use their configured secret.</p>
        <EditForm Model="this" OnValidSubmit="Generate" FormName="generateQRCode">
            <div class="form-floating mb-3"><InputText disabled="@(!_interactiveReady)" id="identifier" class="form-control" placeholder="Identifier" @bind-Value="_identifier" autocomplete="username" maxlength="256" /><label for="identifier">Identifier</label></div>
            <div class="form-floating mb-3"><InputText disabled="@(!_interactiveReady)" id="secret" class="form-control" placeholder="Secret" type="password" @bind-Value="_secret" autocomplete="off" /><label for="secret">Secret</label></div>
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !_interactiveReady)">Generate QR code</button>
        </EditForm>
    }
    else
    {
        <p>Scan this QR code with your personal authenticator, then enter its current code.</p>
        <div class="text-center"><strong>@_setupIdentifier</strong><br /><img style="image-rendering:pixelated;max-width:100%;height:auto" src="data:image/png;base64,@_image" alt="Authenticator setup QR code" /></div>
        <form method="post" action="@(new Uri(new Uri(Navigation.BaseUri), "b2fa/authenticate").AbsolutePath)" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="identifier" value="@_setupIdentifier" />
            <input type="hidden" name="setupSecret" value="@(_adminSetup ? null : _setupSecret)" />
            <div class="form-floating mb-3"><input required id="code" name="code" class="form-control" placeholder="Authentication code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" /><label for="code">Authentication code</label></div>
            <button type="submit" class="btn btn-primary" disabled="@(_busy || !_interactiveReady)">Confirm and sign in</button>
        </form>
    }
    <p class="auth-help"><a href="/login">Back to sign in</a></p>
</div></main>
