@page "/login/qr-code"
@using System.Web
@using BlazorTelemetry.Host.Authentication
@using Microsoft.AspNetCore.RateLimiting
@using QRCoder

@rendermode InteractiveServer

@inject BlazorAuthConfiguration Settings

@code {

    string? qrCodeImageUrl;
    string? base64Image;
    protected string? secretKey = null!;

    [EnableRateLimiting("login")]
    protected void Generate()
    {
        if (!Settings.SecretKey.Equals(secretKey, StringComparison.Ordinal))
        {
            return;
        }

        var authenticator = new TwoFactorAuthenticator();
        var setupResult = authenticator.GenerateSetupCode(Settings.Issuer, Settings.ApplicationName, Settings.SecretKey, 300, 300);
        qrCodeImageUrl = setupResult.QrCodeSetupImageUrl;
        var url = new Uri(qrCodeImageUrl);
        qrCodeImageUrl = HttpUtility.ParseQueryString(url.Query).Get("chl")!;

        var qrGenerator = new QRCodeGenerator();
        var qrCodeData = qrGenerator.CreateQrCode(qrCodeImageUrl, QRCodeGenerator.ECCLevel.Q);
        var qrCode = new PngByteQRCode(qrCodeData);
        var qrCodeImage = qrCode.GetGraphic(20);

        base64Image = Convert.ToBase64String(qrCodeImage);
    }
}


<PageTitle>Set up authentication · BlazorTelemetry</PageTitle>
<main class="auth-page container py-5">
    <div class="auth-card mx-auto">
        <span class="auth-label">TOTP setup</span>
        <h1>Set up your authenticator</h1>
        <p>Enter the secret configured in <code>Blazor2fa:SecretKey</code>, then scan the QR code with your authenticator app.</p>
        @if (qrCodeImageUrl is null)
        {
            <EditForm Model="this" FormName="generateQRCode" OnValidSubmit="Generate">
                <div class="m-auto">
                    <p class="mb-2">Configured secret</p>
                    <InputText class="form-control" type="password" @bind-Value="@secretKey" autocomplete="off" />
                </div>
                <div class="w-100 text-end mt-2">
                    <button type="submit" class="btn btn-primary">Generate QR code</button>
                </div>
            </EditForm>
        }
        else
        {
            <div class="text-center">
                <p class="mb-2 text-body-secondary">Authenticator entry</p>
                <p class="mb-3"><strong>@Settings.Issuer</strong>: @Settings.ApplicationName</p>
                <img style="image-rendering: pixelated; max-width: 100%; height: auto;"
                     src="data:image/png;base64,@base64Image"
                     alt="Authenticator setup QR code">
            </div>
        }

        <p class="auth-help"><a href="/login">Back to sign in</a></p>
    </div>
</main>
