@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject IMediator Repository
@inject BlazorTelemetryOptions Options
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@inject IJSRuntime JS
@using BlazorTelemetry.Host.Contracts.Models.AlertRules

@code {
    [Parameter]
    public RenderFragment? SidebarFooter { get; set; }

    [Parameter]
    public string? InitialView { get; set; }

    protected override void OnInitialized()
    {
        _activeView = InitialView is "requests" or "logs" or "traces" or "metrics" or "alerts" ? InitialView : "dashboards";
    }

    private readonly CancellationTokenSource _lifetime = new();
    private Task? _refreshTask;
    private bool _refreshRequested;
    private Task? _refreshLoopTask;
    private string _activeView = "dashboards";
    private string _search = string.Empty;
    private string? _service;
    private IReadOnlyList<string> _services = [];
    private TelemetryTimeRange _timeRange = new();
    private DateTimeOffset _fromUtc;
    private DateTimeOffset _toUtc;
    private string _logLevel = string.Empty;
    private string _requestStatus = string.Empty;
    private bool _paused;
    private bool _loading = true;
    private string? _error;
    private TelemetrySummary _summary = new(0, 0, 0, 0, 0, 0, null, null, []);
    private TelemetryPage _page = new([], 0, false);
    private IReadOnlyList<AlertRule> _rules = [];
    private IReadOnlyList<Incident> _incidents = [];
    private AlertRule _newRule = CreateRule();
    private string? _selectedTraceId;
    private string? _selectedMetric;
    private TelemetryItem? _selectedLog;
    private TelemetryItem? _selectedSpan;
    private readonly HashSet<long> _collapsedSpans = [];
    private readonly HashSet<string> _expandedTraces = [];
    private ElementReference _spanCloseButton;
    private ElementReference _spanContent;
