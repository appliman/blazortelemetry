    private IReadOnlyList<TelemetryItem> _dashboardTraces = [];
    private IReadOnlyList<TelemetryItem> _dashboardLogs = [];
    private IReadOnlyList<TelemetryItem> _dashboardMetrics = [];
    private DashboardBreakdown _dashboardBreakdown = DashboardBreakdown.Empty;
    private BlazorDashboardMetrics _blazorDashboard = BlazorDashboardMetrics.Empty;
    private int _disposed;

    private async Task RefreshLoop(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Options.DashboardRefreshIntervalSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!_paused && _refreshTask is null)
                {
                    await InvokeAsync(Refresh);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task Refresh()
    {
        _refreshRequested = true;
        return _refreshTask ??= RefreshPending();
    }

    private async Task RefreshPending()
    {
        // Publish the task before any synchronous SQLite work can complete.
        await Task.Yield();
        try
        {
            do
            {
                _refreshRequested = false;
                await RefreshData();
            }
            while (_refreshRequested && !_lifetime.IsCancellationRequested);
        }
        finally
        {
            _refreshTask = null;
        }
    }

    private async Task RefreshData()
    {
        try
        {
            if (!await HasAccess(Options.ReaderPolicy))
            {
                _paused = true;
                _page = new([], 0, false);
                _error = "Your session is no longer valid. Sign in again.";
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            _error = null;
            if (!_timeRange.TryResolve(DateTimeOffset.UtcNow, out var fromUtc, out var toUtc))
            {
                _error = "The time range is invalid. Select a valid time range.";
                return;
            }
            var _selectedService = _service;
            _fromUtc = fromUtc;
            _toUtc = toUtc;
            var _view = _activeView;
            var _querySearch = _search;
            var _queryTrace = _selectedTraceId;
            var _queryLogLevel = _logLevel;
            var _queryRequestStatus = _requestStatus;
            await LoadPanel(() => Repository.GetServices(fromUtc, toUtc, _lifetime.Token), _result => _services = _result.Where(service => !string.Equals(service, HostEnvironment.ApplicationName, StringComparison.Ordinal)).ToArray());
            await LoadPanel(() => Repository.GetSummary(fromUtc, _lifetime.Token, toUtc, _selectedService), _result => _summary = _result with { Services = _result.Services.Where(service => !string.Equals(service, HostEnvironment.ApplicationName, StringComparison.Ordinal)).ToArray() });
            if (_view is "logs" or "traces" or "metrics" or "requests")
            {
                var kind = _view switch
                {
                    "logs" => TelemetryKind.Log,
                    "traces" => TelemetryKind.Trace,
                    "requests" => TelemetryKind.Request,
                    _ => TelemetryKind.Metric
                };
                var (minimumSeverityNumber, maximumSeverityNumber) = _view == "logs"
                    ? LogSeverityRange(_queryLogLevel)
                    : (null, null);
                var (minimumStatusCode, maximumStatusCode, hasStatusCode) = _view == "requests"
                    ? RequestStatusRange(_queryRequestStatus)
                    : (null, null, null);
                await LoadPanel(() => Repository.Query(new TelemetryQuery(
                    kind,
                    _selectedService,
                    _querySearch,
                    _queryTrace,
                    fromUtc,
                    toUtc,
                    Take: 200,
                    MinimumSeverityNumber: minimumSeverityNumber,
                    MaximumSeverityNumber: maximumSeverityNumber,
                    ExcludedServiceName: _view == "requests" ? HostEnvironment.ApplicationName : null,
                    MinimumStatusCode: minimumStatusCode,
                    MaximumStatusCode: maximumStatusCode,
                    HasStatusCode: hasStatusCode,
                    RequireHttpRequestDetails: _view == "requests"), _lifetime.Token), _result => _page = _result);
                if (_view == "metrics" && !_refreshRequested)
                {
                    if (!_page.Items.Any(_item => _item.Name == _selectedMetric))
                    {
                        _selectedMetric = _page.Items.FirstOrDefault()?.Name;
                    }
                    _series = [];
                    if (_selectedMetric is not null)
                    {
                        var _name = _selectedMetric;
                        await LoadPanel(() => Repository.GetMetricSeries(_name, _selectedService, fromUtc, _lifetime.Token, toUtc), _result => _series = _result);
                    }
                }
            }
            else if (_view == "alerts")
            {
                await LoadPanel(() => Repository.GetAlertRules(_lifetime.Token), _result => _rules = _result);
                await LoadPanel(() => Repository.GetIncidents(true, _lifetime.Token), _result => _incidents = _result);
            }
            else if (_view == "dashboards")
            {
                await LoadPanel(() => Repository.Query(new TelemetryQuery(TelemetryKind.Trace, _selectedService, FromUtc: fromUtc, ToUtc: toUtc, Take: 200), _lifetime.Token), _result => _dashboardTraces = _result.Items);
                await LoadPanel(() => Repository.Query(new TelemetryQuery(TelemetryKind.Log, _selectedService, FromUtc: fromUtc, ToUtc: toUtc, Take: 200), _lifetime.Token), _result => _dashboardLogs = _result.Items);
                await LoadPanel(() => Repository.GetResourceMetrics(fromUtc, toUtc, _selectedService, _lifetime.Token), _result => _dashboardMetrics = _result);
                await LoadPanel(() => Repository.GetDashboardBreakdown(fromUtc, _selectedService, HostEnvironment.ApplicationName, _lifetime.Token, toUtc), _result => _dashboardBreakdown = _result);
                await LoadPanel(() => Repository.GetBlazorDashboardMetrics(fromUtc, _selectedService, _lifetime.Token, toUtc), _result => _blazorDashboard = _result);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _error = $"Data is unavailable: {exception.Message}";
        }
        finally
        {
            _loading = false;
            if (!_lifetime.IsCancellationRequested)
            {
                StateHasChanged();
            }
        }
    }

    private async Task LoadPanel<T>(Func<Task<T>> _load, Action<T> _apply)
    {
        if (_refreshRequested || _lifetime.IsCancellationRequested)
        {
            return;
        }
        try
        {
            // Microsoft.Data.Sqlite executes async queries synchronously. Keep them off
            // the circuit dispatcher, with only one database operation per refresh.
            var _result = await Task.Run(_load, _lifetime.Token);
            if (!_refreshRequested && !_lifetime.IsCancellationRequested)
            {
                _apply(_result);
                _loading = false;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception _exception)
        {
            if (!_refreshRequested && !_lifetime.IsCancellationRequested)
            {
                _error = $"Some data is unavailable: {_exception.Message}";
            }
        }
    }

    private async Task ChangeTimeRange(TelemetryTimeRange _range)
    {
        _timeRange = _range;
        await ChangeFilters();
    }

    private async Task ChangeFilters()
    {
        _selectedTraceId = null;
        _selectedLog = null;
        _selectedSpan = null;
        _selectedMetric = null;
        _collapsedSpans.Clear();
        _expandedTraces.Clear();
        await Refresh();
    }

    private async Task SelectView(string view)
    {
        _activeView = view;
        _selectedTraceId = null;
        _selectedLog = null;
        _selectedSpan = null;
        _collapsedSpans.Clear();
        _expandedTraces.Clear();
        ReleaseInactiveViewData(view);
        await Refresh();
    }

    private void ReleaseInactiveViewData(string view)
    {
        if (view != "dashboards")
        {
            _dashboardTraces = [];
            _dashboardLogs = [];
            _dashboardMetrics = [];
            _dashboardBreakdown = DashboardBreakdown.Empty;
            _blazorDashboard = BlazorDashboardMetrics.Empty;
        }

        if (view is not ("logs" or "traces" or "metrics" or "requests"))
        {
            _page = new TelemetryPage([], 0, false);
            _series = [];
        }

        if (view != "alerts")
        {
            _rules = [];
            _incidents = [];
        }
    }

    private void OpenLog(TelemetryItem item)
    {
        _selectedLog = item;
        _focusLogDrawer = true;
        _restoreLogId = null;
    }

    private void CloseLog()
    {
        _restoreLogId = _selectedLog?.Id;
        _selectedLog = null;
    }

    private void HandleLogKey(KeyboardEventArgs args, TelemetryItem item)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenLog(item);
        }
    }

    private void HandleDrawerKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseLog();
        }
    }

    private async Task SelectTrace(string? traceId)
    {
        if (string.IsNullOrWhiteSpace(traceId))
        {
            return;
        }
        _selectedLog = null;
        _restoreLogId = null;
        _selectedTraceId = traceId;
        _service = null;
        _search = string.Empty;
        _collapsedSpans.Clear();
        _expandedTraces.Clear();
        _expandedTraces.Add(traceId);
        _activeView = "traces";
        await Refresh();
    }

    private void OpenSpan(TelemetryItem _item)
    {
        _selectedSpan = _item;
        _focusSpanDrawer = true;
        _restoreSpanId = null;
    }

    private void CloseSpan()
    {
        _restoreSpanId = _selectedSpan?.Id;
        _selectedSpan = null;
    }

    private void HandleSpanDrawerKey(KeyboardEventArgs _args)
    {
        if (_args.Key == "Escape")
        {
            CloseSpan();
        }
    }

    private void ToggleSpan(long _id)
    {
        if (!_collapsedSpans.Add(_id))
        {
            _collapsedSpans.Remove(_id);
        }
    }

    private void ToggleTrace(string traceKey)
    {
        if (!_expandedTraces.Add(traceKey))
        {
            _expandedTraces.Remove(traceKey);
        }
    }

    private IEnumerable<(TelemetryItem Item, int Depth, bool HasChildren)> TraceRows(IEnumerable<TelemetryItem> _items)
    {
        var _ordered = _items.OrderBy(_item => _item.TimestampUtc).ToArray();
        var _ids = _ordered.Where(_item => !string.IsNullOrEmpty(_item.SpanId)).Select(_item => _item.SpanId!).ToHashSet();
        var _children = _ordered.Where(_item => !string.IsNullOrEmpty(_item.ParentSpanId)).ToLookup(_item => _item.ParentSpanId!);
        var _visited = new HashSet<long>();
        var _stack = new Stack<(TelemetryItem Item, int Depth, bool Hidden)>();
        foreach (var _root in _ordered.Where(_item => string.IsNullOrEmpty(_item.ParentSpanId) || !_ids.Contains(_item.ParentSpanId)).Concat(_ordered))
        {
            _stack.Push((_root, 0, false));
            while (_stack.TryPop(out var _entry))
            {
                if (!_visited.Add(_entry.Item.Id))
                {
                    continue;
                }
                var _descendants = _entry.Item.SpanId is { Length: > 0 } _spanId ? _children[_spanId].ToArray() : [];
                if (!_entry.Hidden)
                {
                    yield return (_entry.Item, _entry.Depth, _descendants.Length > 0);
                }
                foreach (var _child in _descendants.Reverse())
                {
                    _stack.Push((_child, _entry.Depth + 1, _entry.Hidden || _collapsedSpans.Contains(_entry.Item.Id)));
                }
            }
        }
    }

    private static double SpanDuration(TelemetryItem _item) => _item.DurationMs is double _duration && double.IsFinite(_duration) ? Math.Max(0, _duration) : 0;
    private static string TraceNumber(double _value) => _value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private async Task SelectMetric(string name)
    {
        _selectedMetric = name;
        await Refresh();
    }

    private async Task<bool> HasAccess(string policy)
    {
        var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        return (await Authorization.AuthorizeAsync(principal, policy)).Succeeded;
    }

    private async Task SaveRule()
    {
        if (!await HasAccess(Options.AdministratorPolicy))
        {
            _error = "Administrator access is required.";
            return;
        }
        var result = await Repository.Send(new SaveAlertRuleRequest(_newRule), _lifetime.Token);
        if (result.HasError)
        {
            _error = string.Join(" ", result.BrokenRules.Select(rule => rule.Message));
            return;
        }
        _newRule = CreateRule();
        await Refresh();
    }

    private async Task DeleteRule(int id)
    {
        if (!await HasAccess(Options.AdministratorPolicy))
        {
            _error = "Administrator access is required.";
            return;
        }
        await Repository.DeleteAlertRule(id, _lifetime.Token);
        await Refresh();
    }

    private async Task Acknowledge(long id)
    {
        if (!await HasAccess(Options.ReaderPolicy))
        {
            _error = "Your session is no longer valid. Sign in again.";
            return;
        }
        await Repository.AcknowledgeIncident(id, _lifetime.Token);
        await Refresh();
    }

    private static AlertRule CreateRule() => new()
    {
        Name = "New rule",
        Type = AlertRuleType.ErrorLogs,
        Threshold = 5,
        WindowMinutes = 5,
        ConfirmationMinutes = 1,
        ServiceName = "*"
    };

    private static string FormatTime(DateTimeOffset value) => value.ToLocalTime().ToString("HH:mm:ss.fff");
    private static string FormatFullTime(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff zzz");
    private static string FormatUtcTime(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff 'UTC'");
    private static string FormatRelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value;
        if (elapsed < TimeSpan.Zero) return "in the future";
        if (elapsed.TotalSeconds < 10) return "just now";
        if (elapsed.TotalMinutes < 1) return $"{(int)elapsed.TotalSeconds} seconds ago";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes} minutes ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours} hours ago";
        return $"{(int)elapsed.TotalDays} days ago";
    }

    private static IReadOnlyList<LogDetailEntry> JsonEntries(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return [new LogDetailEntry("Value", FormatJsonValue(document.RootElement))];
            }

            return document.RootElement.EnumerateObject()
                .Select(property => new LogDetailEntry(property.Name, FormatJsonValue(property.Value)))
                .ToArray();
        }
        catch (JsonException)
        {
            return [new LogDetailEntry("Raw value", json)];
        }
    }

    private static string FormatJsonValue(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? string.Empty,
        JsonValueKind.Null => "null",
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.Number => value.GetRawText(),
        _ => JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true })
    };

    private static IReadOnlyList<LogDetailEntry> TypedEntries(TelemetryItem _item)
    {
        var _entries = new List<LogDetailEntry>();
        void Add(string _name, object? _value)
        {
            if (_value is not null)
            {
                _entries.Add(new(_name, Convert.ToString(_value, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty));
            }
        }
        Add("CollectionsTruncated", _item.CollectionsTruncated ? true : null);
        Add("ScopeName", _item.ScopeName);
        Add("ScopeVersion", _item.ScopeVersion);
        Add("Flags", _item.Flags);
        Add("DroppedAttributesCount", _item.DroppedAttributesCount);
        Add("SpanKind", _item.SpanKind);
        Add("Source", _item.Source);
        Add("CircuitId", _item.CircuitId);
        Add("AggregationTemporality", _item.AggregationTemporality);
        Add("StartTimeUtc", _item.StartTimeUtc);
        Add("IsMonotonic", _item.IsMonotonic);
        Add("Count", _item.Count);
        Add("Sum", _item.Sum);
        Add("Minimum", _item.Minimum);
        Add("Maximum", _item.Maximum);
        Add("Scale", _item.Scale);
        Add("ZeroCount", _item.ZeroCount);
        Add("PositiveOffset", _item.PositiveOffset);
        Add("NegativeOffset", _item.NegativeOffset);
        foreach (var _event in _item.Events)
        {
            Add($"Event[{_event.Ordinal}]", $"{_event.TimestampUtc:O} {_event.Name}");
            foreach (var _attribute in JsonEntries(_event.AttributesJson))
            {
                Add($"Event[{_event.Ordinal}].{_attribute.Name}", _attribute.Value);
            }
        }
        foreach (var _link in _item.Links)
        {
            Add($"Link[{_link.Ordinal}]", $"{_link.TraceId}/{_link.SpanId}");
            foreach (var _attribute in JsonEntries(_link.AttributesJson))
            {
                Add($"Link[{_link.Ordinal}].{_attribute.Name}", _attribute.Value);
            }
        }
        return _entries;
    }

    private static IReadOnlyList<LogDetailEntry> ResourceEntries(TelemetryItem _item)
    {
        var _entries = JsonEntries(_item.ResourceAttributesJson).ToList();
        if (_item.ServiceName is { } _ServiceName)
        {
            _entries.Add(new("service.name", _ServiceName));
        }
        if (_item.ServiceVersion is { } _ServiceVersion)
        {
            _entries.Add(new("service.version", _ServiceVersion));
        }
        if (_item.Environment is { } _Environment)
        {
            _entries.Add(new("deployment.environment.name", _Environment));
        }
        if (_item.ServiceInstanceId is { } _ServiceInstanceId)
        {
            _entries.Add(new("service.instance.id", _ServiceInstanceId));
        }
        if (_item.SdkName is { } _SdkName)
        {
            _entries.Add(new("telemetry.sdk.name", _SdkName));
        }
        if (_item.SdkLanguage is { } _SdkLanguage)
        {
            _entries.Add(new("telemetry.sdk.language", _SdkLanguage));
        }
        if (_item.SdkVersion is { } _SdkVersion)
        {
            _entries.Add(new("telemetry.sdk.version", _SdkVersion));
        }
        return _entries;
    }

    private sealed record LogDetailEntry(string Name, string Value);

    private ValueTask FocusFirstDrawerControl() => _logCloseButton.FocusAsync();

    private ValueTask FocusLastDrawerControl() => !string.IsNullOrWhiteSpace(_selectedLog?.TraceId)
        ? _logTraceButton.FocusAsync()
        : _logCloseButton.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Do not query twice during prerender or delay the initial HTML response.
            await Refresh();
            if (!_lifetime.IsCancellationRequested)
            {
                _refreshLoopTask = RefreshLoop(_lifetime.Token);
            }
        }
        if (_focusSpanDrawer)
        {
            _focusSpanDrawer = false;
            await _spanCloseButton.FocusAsync();
        }
        else if (_restoreSpanId is long _spanId)
        {
            _restoreSpanId = null;
            _dashboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./telemetry-chart.js");
            await _dashboardModule.InvokeVoidAsync("focusById", $"bt-span-row-{_spanId}");
        }
        if (_focusLogDrawer)
        {
            _focusLogDrawer = false;
            await _logCloseButton.FocusAsync();
        }
        else if (_restoreLogId is long logId)
        {
            _restoreLogId = null;
            _dashboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./telemetry-chart.js");
            await _dashboardModule.InvokeVoidAsync("focusById", $"bt-log-row-{logId}");
        }
    }
    private static string ShortId(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Length <= 10 ? value : value[..10];
    private static string SeverityClass(TelemetryItem item)
    {
        if (item.StatusCode == 2)
        {
            return "error";
        }

        return (item.SeverityNumber ?? 0) switch
        {
            >= 21 => "critical",
            >= 17 => "error",
            >= 13 => "warning",
            >= 9 => "information",
            >= 5 => "debug",
            >= 1 => "trace",
            _ => item.StatusCode == 1 ? "success" : "neutral"
        };
    }
    private static (int? Minimum, int? Maximum) LogSeverityRange(string level) => level switch
    {
        "trace" => (1, 4),
        "debug" => (5, 8),
        "information" => (9, 12),
        "warning" => (13, 16),
        "error" => (17, 20),
        "critical" => (21, 24),
        _ => (null, null)
    };
    private static (int? Minimum, int? Maximum, bool? HasStatusCode) RequestStatusRange(string status) => status switch
    {
        "in-progress" => (null, null, false),
        "1xx" => (100, 199, true),
        "2xx" => (200, 299, true),
        "3xx" => (300, 399, true),
        "4xx" => (400, 499, true),
        "5xx" => (500, 599, true),
        _ => (null, null, null)
    };
    private string ViewTitle() => _activeView switch { "requests" => "Requests", "logs" => "Structured logs", "traces" => "Distributed traces", "metrics" => "Metrics", "dashboards" => "Dashboard", "alerts" => "Alert center", _ => "Dashboard" };
    private string ViewSubtitle() => _activeView switch { "requests" => "Live HTTP requests and recent route activity · selected period", "logs" => "Messages, attributes, and correlation context", "traces" => "From entry point to dependencies, span by span", "metrics" => "Instruments, dimensions, and trends over time", "dashboards" => "Operational views shared by the team", "alerts" => "Rules, incidents, and notifications", _ => "Operational views shared by the team" };

    private static string RequestAttribute(string json, string key)
    {
        try
        {
            using var _document = JsonDocument.Parse(json);
            return _document.RootElement.TryGetProperty(key, out var _value) && _value.ValueKind != JsonValueKind.Null
                ? _value.ToString() : "—";
        }
        catch (JsonException)
        {
            return "—";
        }
    }

    private static string RequestIp(TelemetryItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.ClientAddress))
        {
            return item.ClientAddress.Trim();
        }
        foreach (var key in new[] { "client.address", "network.peer.address", "http.client_ip", "net.sock.peer.addr", "net.peer.ip" })
        {
            var value = RequestAttribute(item.AttributesJson, key);
            if (value != "—" && !string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return "—";
    }

    private static bool HasCorrelatedTrace(TelemetryItem item) =>
        !string.IsNullOrWhiteSpace(item.TraceId) && !string.IsNullOrWhiteSpace(item.SpanId);

    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref _disposed, 1) != 0)
        {
            return;
        }

        _lifetime.Cancel();
        if (_refreshTask is not null)
        {
            await _refreshTask;
        }
        if (_refreshLoopTask is not null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        if (_dashboardModule is not null)
        {
            try
            {
                await _dashboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _lifetime.Dispose();
    }
}

<TelemetryShell ActiveView="@_activeView" ActiveIncidents="@_summary.ActiveIncidents" ViewChanged="SelectView" SidebarFooter="SidebarFooter">
    <main class="bt-main">
        <header class="bt-toolbar">
            <div>
                <h1>@ViewTitle()</h1>
                <p>@ViewSubtitle()</p>
                <span class="bt-toolbar-health"><i></i> Collector active <small>OTLP · HTTP/protobuf</small></span>
            </div>
            <div class="bt-toolbar-actions">
                <label class="bt-search"><span class="visually-hidden">Search</span><input @bind="_search" @bind:event="oninput" @onchange="Refresh" placeholder="Search telemetry" /></label>
                <select @bind="_service" @bind:after="ChangeFilters" aria-label="Filter by application">
                    <option value="">All applications</option>
                    @if (!string.IsNullOrWhiteSpace(_service) && !_services.Contains(_service))
                    {
                        <option value="@_service">@_service (no data)</option>
                    }
                    @foreach (var service in _services)
                    {
                        <option value="@service">@service</option>
                    }
                </select>
                <TelemetryTimeRangePicker ValueChanged="ChangeTimeRange" />
                @if (_activeView == "logs")
                {
                    <label class="bt-level-filter">
                        <span>Level</span>
                        <select @bind="_logLevel" @bind:after="Refresh" aria-label="Filter logs by level">
                            <option value="">All levels</option>
                            <option value="trace">Trace</option>
                            <option value="debug">Debug</option>
                            <option value="information">Information</option>
                            <option value="warning">Warning</option>
                            <option value="error">Error</option>
                            <option value="critical">Critical</option>
                        </select>
                    </label>
                }
                else if (_activeView == "requests")
                {
                    <label class="bt-level-filter">
                        <span>Status</span>
                        <select @bind="_requestStatus" @bind:after="Refresh" aria-label="Filter requests by status">
                            <option value="">All statuses</option>
                            <option value="in-progress">In progress</option>
                            <option value="1xx">1xx · Informational</option>
                            <option value="2xx">2xx · Successful</option>
                            <option value="3xx">3xx · Redirection</option>
                            <option value="4xx">4xx · Client error</option>
                            <option value="5xx">5xx · Server error</option>
                        </select>
                    </label>
                }
                <button class="bt-live @(_paused ? "paused" : null)" @onclick="() => _paused = !_paused"><span></span>@(_paused ? "Resume" : "Live")</button>
            </div>
        </header>

        @if (_error is not null)
        {
            <div class="bt-error" role="alert">@_error <button @onclick="Refresh">Retry</button></div>
        }
        @if (_loading)
        {
            <div class="bt-loading" aria-live="polite"><span></span>Loading signals…</div>
        }
        else if (_activeView is "logs" or "traces" or "metrics" or "requests")
        {
            <div class="@(_activeView == "metrics" ? "bt-metrics-view" : "bt-signal-view")">
                @if (_activeView == "metrics" && _selectedMetric is not null)
                {
                    <section class="bt-metric-focus">
                        <div class="bt-section-heading"><div><h2>@_selectedMetric</h2><p>@_series.Count points · selected period</p></div></div>
                        <TelemetryChart Labels="@_series.Select(point => point.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")).ToList()" Values="@_series.Select(point => point.Value).ToList()" />
                    </section>
                }
                <section class="bt-table-region">
                <div class="bt-result-count">@_page.Total.ToString("N0") results @if (_page.IsTruncated) { <span>· limited to the 200 most recent</span> }</div>
                @if (_page.Items.Count == 0)
                {
                    <div class="bt-empty"><strong>No signals match this filter</strong><p>Expand the time range or check the exporter configuration.</p></div>
                }
                else if (_activeView == "requests")
                {
                    <p class="bt-result-count">HTTP duration covers server processing. In progress means no HTTP completion has been recorded yet.</p>
                    <table class="bt-requests-table"><thead><tr><th>Date / time</th><th>Route</th><th>Method</th><th>IP address</th><th>User agent</th><th>Trace</th><th>Duration</th><th>Status</th></tr></thead><tbody>
                    @foreach (var _item in _page.Items)
                    {
                        <tr @key="_item.Id">
                            <td class="mono">@_item.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            <td class="bt-request-route">@_item.Name</td>
                            <td class="mono">@_item.Body</td>
                            <td class="mono">@RequestIp(_item)</td>
                            <td class="bt-request-context">@(_item.UserAgent ?? "—")</td>
                            <td class="bt-request-trace mono">
                                @if (HasCorrelatedTrace(_item))
                                {
                                    <button class="bt-link" title="Open trace @_item.TraceId" @onclick="() => SelectTrace(_item.TraceId)">@ShortId(_item.TraceId)</button>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="mono">@(_item.DurationMs.HasValue ? $"{_item.DurationMs.Value:N1} ms" : _item.Body == "Blazor navigation" ? "—" : "In progress")</td>
                            <td>@(_item.StatusCode?.ToString() ?? "—")</td>
                        </tr>
                    }
                    </tbody></table>
                }
                else if (_activeView == "logs")
                {
                    <table><thead><tr><th>Time</th><th>Level</th><th>Service</th><th>Message</th><th>Trace</th></tr></thead><tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr id="bt-log-row-@item.Id" class="bt-log-row @(_selectedLog?.Id == item.Id ? "selected" : null)" tabindex="0" role="button" aria-label="Open log details for @item.Name" @onclick="() => OpenLog(item)" @onkeydown="args => HandleLogKey(args, item)"><td class="mono">@FormatTime(item.TimestampUtc)</td><td><span class="bt-severity @SeverityClass(item)">@(item.SeverityText ?? "INFO")</span></td><td>@item.ServiceName</td><td class="bt-message"><strong>@item.Name</strong><span>@item.Body</span></td><td><span class="bt-trace-cell mono">@ShortId(item.TraceId)</span></td></tr>
                    }
                    </tbody></table>
                }
                else if (_activeView == "traces")
                {
                    <div class="bt-trace-list">
                    @foreach (var _trace in _page.Items.GroupBy(_item => _item.TraceId ?? $"item-{_item.Id}"))
                    {
                        var _start = _trace.Min(_item => _item.TimestampUtc);
                        var _duration = _trace.Max(_item => (_item.TimestampUtc - _start).TotalMilliseconds + SpanDuration(_item));
                        var _rows = TraceRows(_trace).ToArray();
                        var _traceName = _rows[0].Item.Name;
                        var _isExpanded = _expandedTraces.Contains(_trace.Key);
                        <section class="bt-trace-group" @key="_trace.Key" aria-label="Trace @_trace.Key">
                            <header class="bt-trace-summary">
                                <button class="bt-trace-toggle" type="button" aria-label="@(_isExpanded ? "Collapse" : "Expand") trace @ShortId(_trace.First().TraceId)" aria-expanded="@_isExpanded" @onclick="() => ToggleTrace(_trace.Key)"><span class="bt-nav-icon" aria-hidden="true">@(_isExpanded ? "expand_more" : "chevron_right")</span></button>
                                <strong class="bt-trace-name" title="@_traceName">@_traceName</strong>
                                <time class="bt-trace-start mono" datetime="@_start.ToString("O")" title="@FormatUtcTime(_start)">@_start.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</time>
                                <span>Trace <code>@ShortId(_trace.First().TraceId)</code></span>
                                <span>Duration <b>@TraceNumber(_duration) ms</b></span>
                                <span>Resources <b>@_trace.Select(_item => _item.ServiceName).Distinct().Count()</b></span>
                                <span>Spans <b>@_trace.Count()</b></span>
                                @if (_selectedTraceId is null && !string.IsNullOrWhiteSpace(_trace.First().TraceId))
                                {
                                    <button class="bt-link" @onclick="() => SelectTrace(_trace.First().TraceId)">Focus trace</button>
                                }
                            </header>
                            @if (_isExpanded)
                            {
                            <div class="bt-trace-scroll">
                                <div class="bt-trace-columns"><span>Name</span><span>Resource</span><div class="bt-trace-axis">@for (var _tick = 0; _tick <= 4; _tick++) { <span>@TraceNumber(_duration * _tick / 4) ms</span> }</div><span>Duration</span></div>
                                @foreach (var _row in _rows)
                                {
                                    var _item = _row.Item;
                                    var _offset = (_item.TimestampUtc - _start).TotalMilliseconds;
                                    <div class="bt-span-line @(_selectedSpan?.Id == _item.Id ? "selected" : null)" @key="_item.Id">
                                        <button id="bt-span-row-@_item.Id" type="button" class="bt-span-row @SeverityClass(_item)" @onclick="() => OpenSpan(_item)" aria-label="Open span details for @_item.Name">
                                            <span class="bt-span-name" style="--depth: @Math.Min(_row.Depth, 12)"><span class="bt-nav-icon" aria-hidden="true">@( _row.HasChildren ? "account_tree" : "horizontal_rule")</span><strong title="@_item.Name">@_item.Name</strong></span>
                                            <span class="bt-span-resource" title="@_item.ServiceName">@_item.ServiceName</span>
                                            <span class="bt-waterfall-track"><i style="left: @TraceNumber(_offset / Math.Max(.001, _duration) * 100)%; width: @TraceNumber(SpanDuration(_item) / Math.Max(.001, _duration) * 100)%"></i></span>
                                            <span class="bt-span-duration">@(_item.DurationMs.HasValue ? TraceNumber(SpanDuration(_item)) + " ms" : "—")</span>
                                        </button>
                                        @if (_row.HasChildren)
                                        {
                                            <button class="bt-span-toggle" type="button" aria-label="Toggle children of @_item.Name" aria-expanded="@(!_collapsedSpans.Contains(_item.Id))" @onclick="() => ToggleSpan(_item.Id)"><span class="bt-nav-icon" aria-hidden="true">@(_collapsedSpans.Contains(_item.Id) ? "chevron_right" : "expand_more")</span></button>
                                        }
                                    </div>
                                }
                            </div>
                            }
                        </section>
                    }
                    </div>
                }
                else
                {
                    <table><thead><tr><th>Instrument</th><th>Type</th><th>Service</th><th>Value</th><th>Time</th></tr></thead><tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr class="@(_selectedMetric == item.Name ? "selected" : null)" @onclick="() => SelectMetric(item.Name)"><td><strong>@item.Name</strong><small>@item.Body</small></td><td><span class="bt-type">@item.MetricType</span></td><td>@item.ServiceName</td><td class="mono value">@(item.NumericValue?.ToString("N3") ?? "—") @item.Unit</td><td class="mono">@FormatTime(item.TimestampUtc)</td></tr>
                    }
                    </tbody></table>
                }
                </section>
            </div>
        }
        else if (_activeView == "alerts")
        {
            <div class="bt-alert-layout">
                <section>
                    <div class="bt-section-heading"><div><h2>Incidents</h2><p>Full lifecycle: firing, acknowledgement, and resolution</p></div></div>
                    @if (_incidents.Count == 0) { <div class="bt-empty compact"><strong>No incidents</strong><p>Active rules are evaluated every @Options.EvaluationIntervalSeconds seconds.</p></div> }
                    @foreach (var incident in _incidents)
                    {
                        <article class="bt-incident @incident.State.ToString().ToLowerInvariant()"><div><span>@incident.Severity</span><h3>@incident.RuleName</h3><p>@incident.ServiceName · value @incident.ObservedValue.ToString("N2") / threshold @incident.Threshold.ToString("N2")</p></div><div><strong>@incident.State</strong><time>@incident.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>@if (!incident.AcknowledgedUtc.HasValue && incident.State != IncidentState.Resolved) { <button @onclick="() => Acknowledge(incident.Id)">Acknowledge</button> }</div></article>
                    }
                </section>
                <section>
                    <div class="bt-section-heading"><div><h2>Rules</h2><p>@_rules.Count configured rules</p></div></div>
                    @foreach (var rule in _rules)
                    {
                        <article class="bt-rule"><div><strong>@rule.Name</strong><span>@rule.Type · threshold @rule.Threshold · @rule.WindowMinutes min</span></div><button title="Delete rule" @onclick="() => DeleteRule(rule.Id)">Delete</button></article>
                    }
                    <AuthorizeView Policy="@Options.AdministratorPolicy" Context="authorizationContext">
                        <EditForm Model="_newRule" OnValidSubmit="SaveRule" class="bt-rule-form">
                            <h3>New rule</h3>
                            <div class="form-floating"><InputText class="form-control" @bind-Value="_newRule.Name" placeholder="Name" /><label>Rule name</label></div>
                            <div class="form-floating"><InputSelect class="form-select" @bind-Value="_newRule.Type"><option value="@AlertRuleType.ErrorLogs">Error count</option><option value="@AlertRuleType.TraceErrorRate">Error rate</option><option value="@AlertRuleType.TraceLatency">p95 latency</option><option value="@AlertRuleType.MetricThreshold">Metric threshold</option><option value="@AlertRuleType.TelemetryAbsence">Telemetry absence</option></InputSelect><label>Monitored signal</label></div>
                            <div class="bt-form-row"><div class="form-floating"><InputNumber class="form-control" @bind-Value="_newRule.Threshold" placeholder="Threshold" /><label>Threshold</label></div><div class="form-floating"><InputNumber class="form-control" @bind-Value="_newRule.WindowMinutes" placeholder="Window" /><label>Window (min)</label></div></div>
                            <div class="bt-checks"><label><InputCheckbox @bind-Value="_newRule.NotifyWebhook" /> Webhook</label><label><InputCheckbox @bind-Value="_newRule.NotifyEmail" /> Email</label><label><InputCheckbox @bind-Value="_newRule.NotifyNtfy" /> ntfy</label></div>
                            <button class="bt-primary" type="submit">Create rule</button>
                        </EditForm>
                    </AuthorizeView>
                </section>
            </div>
        }
        else if (_activeView == "dashboards")
        {
            <DefaultTelemetryDashboard Summary="_summary" Traces="_dashboardTraces" Logs="_dashboardLogs" Metrics="_dashboardMetrics" Breakdown="_dashboardBreakdown" BlazorMetrics="_blazorDashboard" FromUtc="_fromUtc" ToUtc="_toUtc" />
        }
    </main>

    @if (_selectedSpan is { } _span)
    {
        <div class="bt-log-backdrop bt-span-backdrop" role="presentation" @onclick="CloseSpan" @onkeydown="HandleSpanDrawerKey">
            <aside class="bt-log-drawer bt-span-drawer offcanvas offcanvas-end show" role="dialog" aria-modal="true" aria-labelledby="bt-span-title" @onclick:stopPropagation="true">
                <span class="bt-focus-sentinel" tabindex="0" @onfocus="async _ => await _spanContent.FocusAsync()"></span>
                <header class="bt-log-drawer-header">
                    <div><span class="bt-severity @SeverityClass(_span)">@(_span.StatusCode == 2 ? "Error" : _span.StatusCode == 1 ? "OK" : "Unset")</span><h2 id="bt-span-title">@_span.Name</h2><p>Resource @_span.ServiceName · Duration @TraceNumber(SpanDuration(_span)) ms</p></div>
                    <button @ref="_spanCloseButton" class="bt-drawer-close" type="button" aria-label="Close span details" title="Close (Escape)" @onclick="CloseSpan">×</button>
                </header>
                <div @ref="_spanContent" class="bt-log-drawer-content" tabindex="0" role="region" aria-label="Span properties">
                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Span</h3></div>
                        <dl class="bt-attribute-list">
                            <div><dt>Span ID</dt><dd><pre>@(_span.SpanId ?? "—")</pre></dd></div>
                            <div><dt>Trace ID</dt><dd><pre>@(_span.TraceId ?? "—")</pre></dd></div>
                            <div><dt>Parent span ID</dt><dd><pre>@(_span.ParentSpanId ?? "—")</pre></dd></div>
                            <div><dt>Name</dt><dd><pre>@_span.Name</pre></dd></div>
                            <div><dt>Start time</dt><dd><pre>@FormatUtcTime(_span.TimestampUtc)</pre></dd></div>
                            <div><dt>Duration</dt><dd><pre>@(_span.DurationMs.HasValue ? TraceNumber(SpanDuration(_span)) + " ms" : "—")</pre></dd></div>
                            @foreach (var _entry in JsonEntries(_span.AttributesJson))
                            {
                                <div><dt>@_entry.Name</dt><dd><pre>@_entry.Value</pre></dd></div>
                            }
                        </dl>
                    </section>
                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Resource</h3></div>
                        <dl class="bt-attribute-list">
                            <div><dt>Service</dt><dd><pre>@_span.ServiceName</pre></dd></div>
                            <div><dt>Version</dt><dd><pre>@(_span.ServiceVersion ?? "—")</pre></dd></div>
                            <div><dt>Environment</dt><dd><pre>@(_span.Environment ?? "—")</pre></dd></div>
                            @foreach (var _entry in ResourceEntries(_span))
                            {
                                <div><dt>@_entry.Name</dt><dd><pre>@_entry.Value</pre></dd></div>
                            }
                        </dl>
                    </section>
                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Details and events</h3></div>
                        <dl class="bt-attribute-list">
                            @foreach (var _entry in TypedEntries(_span))
                            {
                                <div><dt>@_entry.Name</dt><dd><pre>@_entry.Value</pre></dd></div>
                            }
                        </dl>
                        @if (TypedEntries(_span).Count == 0)
                        {
                            <p class="bt-log-no-value">No additional details were provided.</p>
                        }
                    </section>
                </div>
                <span class="bt-focus-sentinel" tabindex="0" @onfocus="async _ => await _spanCloseButton.FocusAsync()"></span>
            </aside>
        </div>
    }

    @if (_selectedLog is not null)
    {
        var log = _selectedLog;
        <div class="bt-log-backdrop" role="presentation" @onclick="CloseLog" @onkeydown="HandleDrawerKey">
            <aside class="bt-log-drawer" role="dialog" aria-modal="true" aria-labelledby="bt-log-title" @onclick:stopPropagation="true">
                <span class="bt-focus-sentinel" tabindex="0" @onfocus="async _ => await FocusLastDrawerControl()"></span>
                <header class="bt-log-drawer-header">
                    <div>
                        <span class="bt-severity @SeverityClass(log)">@(log.SeverityText ?? "INFO")</span>
                        <span class="bt-log-relative">@FormatRelativeTime(log.TimestampUtc)</span>
                        <h2 id="bt-log-title">@log.Name</h2>
                        <p>@log.ServiceName @if (!string.IsNullOrWhiteSpace(log.Environment)) { <span>· @log.Environment</span> }</p>
                    </div>
                    <button @ref="_logCloseButton" class="bt-drawer-close" type="button" aria-label="Close details" title="Close (Escape)" @onclick="CloseLog">×</button>
                </header>

                <div class="bt-log-drawer-content">
                    <section class="bt-log-meta" aria-label="Timestamp and correlation">
                        <dl>
                            <div><dt>Local time</dt><dd class="mono">@FormatFullTime(log.TimestampUtc)</dd></div>
                            <div><dt>UTC time</dt><dd class="mono">@FormatUtcTime(log.TimestampUtc)</dd></div>
                            <div><dt>Epoch ms</dt><dd class="mono">@log.TimestampUtc.ToUnixTimeMilliseconds()</dd></div>
                            <div><dt>Observed</dt><dd class="mono">@FormatUtcTime(log.ObservedUtc)</dd></div>
                            <div><dt>OTLP level</dt><dd>@(log.SeverityText ?? "—") <span class="mono">#@(log.SeverityNumber?.ToString() ?? "—")</span></dd></div>
                            <div><dt>Service</dt><dd>@log.ServiceName</dd></div>
                            <div><dt>Version</dt><dd>@(log.ServiceVersion ?? "—")</dd></div>
                            <div><dt>Environment</dt><dd>@(log.Environment ?? "—")</dd></div>
                            <div><dt>Trace ID</dt><dd class="bt-id-value"><code>@(log.TraceId ?? "—")</code>@if (!string.IsNullOrWhiteSpace(log.TraceId)) { <button @ref="_logTraceButton" class="bt-link" @onclick="() => SelectTrace(log.TraceId)">Open trace</button> }</dd></div>
                            <div><dt>Span ID</dt><dd><code>@(log.SpanId ?? "—")</code></dd></div>
                        </dl>
                    </section>

                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Raw message</h3><span>@((log.Body ?? string.Empty).Length.ToString("N0")) characters</span></div>
                        @if (string.IsNullOrEmpty(log.Body))
                        {
                            <p class="bt-log-no-value">No body was provided.</p>
                        }
                        else
                        {
                            <pre class="bt-log-body">@log.Body</pre>
                        }
                    </section>

                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Log attributes</h3><span>@JsonEntries(log.AttributesJson).Count</span></div>
                        <dl class="bt-attribute-list">
                            @foreach (var entry in JsonEntries(log.AttributesJson))
                            {
                                <div><dt>@entry.Name</dt><dd><pre>@entry.Value</pre></dd></div>
                            }
                        </dl>
                    </section>

                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>OpenTelemetry resource</h3><span>@ResourceEntries(log).Count</span></div>
                        <dl class="bt-attribute-list">
                            @foreach (var entry in ResourceEntries(log))
                            {
                                <div><dt>@entry.Name</dt><dd><pre>@entry.Value</pre></dd></div>
                            }
                        </dl>
                    </section>

                    <section class="bt-log-section">
                        <div class="bt-log-section-title"><h3>Scope and transport</h3><span>@TypedEntries(log).Count</span></div>
                        <dl class="bt-attribute-list">
                            @foreach (var entry in TypedEntries(log))
                            {
                                <div><dt>@entry.Name</dt><dd><pre>@entry.Value</pre></dd></div>
                            }
                        </dl>
                    </section>
                </div>
                <span class="bt-focus-sentinel" tabindex="0" @onfocus="async _ => await FocusFirstDrawerControl()"></span>
            </aside>
        </div>
    }
</TelemetryShell>
