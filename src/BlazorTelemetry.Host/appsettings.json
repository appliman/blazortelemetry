{
  "Kestrel": {
    "Endpoints": {
      "Web": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "OtlpGrpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      }
    }
  },
  "Blazor2fa": {
    "SecretKey": "demo",
    "Issuer": "BlazorTelemetry",
    "AllowedUserLogins": [
      "demo@demo.com"
    ],
    "CookieDurationInDays": 15
  },
  "BlazorTelemetry": {
    "ConnectionString": "Data Source=Data/telemetry.db;Cache=Shared",
    "RawRetentionDays": 7,
    "MetricRetentionDays": 30,
    "MaximumDatabaseBytes": 10737418240,
    "QueueCapacity": 16,
    "MaximumRequestBytes": 8388608,
    "MaximumDashboardMetricRows": 5000,
    "DashboardRefreshIntervalSeconds": 5,
    "DbContextPoolSize": 16,
    "RequireIngestionKey": false,
    "IngestionKeys": {},
    "Webhook": {},
    "Smtp": {},
    "Ntfy": { "ServerUrl": "https://ntfy.sh" }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning", "BlazorTelemetry": "Information" } },
  "AllowedHosts": "*"
}
