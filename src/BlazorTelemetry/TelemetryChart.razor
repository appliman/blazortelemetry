@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    private readonly string _elementId = $"telemetry-chart-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;

    [Parameter]
    public IReadOnlyList<string> Labels { get; set; } = [];

    [Parameter]
    public IReadOnlyList<double> Values { get; set; } = [];

    [Parameter]
    public IReadOnlyList<double> SecondaryValues { get; set; } = [];

    [Parameter]
    public string SeriesLabel { get; set; } = "Value";

    [Parameter]
    public string SecondarySeriesLabel { get; set; } = "Comparison";

    [Parameter]
    public string Color { get; set; } = "#76e4b8";

    [Parameter]
    public string SecondaryColor { get; set; } = "#78a9ff";

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public string Type { get; set; } = "line";

    [Parameter]
    public bool ShowValues { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Time series trend";

    [Parameter]
    public int Height { get; set; } = 220;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorTelemetry/telemetry-chart.js");
        await _module.InvokeVoidAsync("render", _elementId, Labels, Values, SecondaryValues, SeriesLabel, SecondarySeriesLabel, Color, SecondaryColor, Unit, Type, ShowValues);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("dispose", _elementId);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit is already gone, so there is no JavaScript resource left to release.
        }
    }
}

<div id="@_elementId" class="telemetry-chart" style="height: @(Height)px" role="img" aria-label="@AriaLabel"></div>
